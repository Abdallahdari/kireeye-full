# Server-to-server URL for the backend API (used by Next.js rewrites and
# Server Components — never exposed to the browser). The browser always talks
# to the frontend's own origin at /api/*, which Next proxies to this URL.
#
# Local dev (backend running via `npm run dev` on your machine):
INTERNAL_API_URL=http://localhost:5000

# Docker Compose (backend running as the "backend" service):
# INTERNAL_API_URL=http://backend:5000
