# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/home-rental

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_value
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# Super Admin Seed (used only by npm run seed:admin)
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!Strong
SUPER_ADMIN_PHONE=+10000000000

# Uploaded listing images are stored on disk here (served at /api/uploads)
UPLOAD_DIR=uploads

# Image storage in S3. Leave S3_BUCKET empty to store images in UPLOAD_DIR instead.
# The IAM user needs s3:PutObject, s3:GetObject and s3:DeleteObject on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Rate limiting
# General limit for every /api route, per client IP.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
# Proxies whose X-Forwarded-For is trusted (Express "trust proxy"). The default
# trusts private networks (the Next.js server / Docker network) so limits apply
# per visitor. Behind a public load balancer, set its IP/CIDR or hop count.
TRUST_PROXY=loopback, linklocal, uniquelocal
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Email (Gmail SMTP) — leave SMTP_USER/SMTP_PASS unset to log emails to the
# console instead of sending them. SMTP_PASS must be a 16-character Gmail
# "App Password" (myaccount.google.com/apppasswords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Stayly <your-gmail-address@gmail.com>
# Inbox that receives contact-form messages (defaults to SMTP_USER)
CONTACT_EMAIL=

# Billing — first FREE_LISTING_LIMIT listings are free (lifetime), then a
# monthly subscription is required to publish more.
FREE_LISTING_LIMIT=5
SUBSCRIPTION_PRICE_USD=10

# WaafiPay (EVC Plus / ZAAD / SAHAL). Get these from merchant.waafipay.com.
# Leave unset in development to use WAAFI_MODE=mock (fake instant payments).
# WAAFI_MODE: live | sandbox | mock (mock is refused when NODE_ENV=production)
WAAFI_MODE=
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
# Optional override; defaults to https://api.waafipay.net/asm (live)
# or https://sandbox.waafipay.com/asm (sandbox)
WAAFI_API_URL=
