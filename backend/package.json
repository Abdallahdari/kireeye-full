    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
